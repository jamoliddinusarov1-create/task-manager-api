# Systemd Service fayli.
# NIMA UCHUN KERAK:
# FastAPI (Uvicorn) serverini Linux tizimida fon xizmati (daemon) sifatida doimiy ishlatish;
# Server o'chib-yonsa yoki xatolik yuz bersa, dasturni avtomatik qayta ishga tushirish (Restart=always).

[Unit]
Description=FastAPI Task Manager Application Service
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/task-manager-api
EnvironmentFile=/home/ubuntu/task-manager-api/.env
ExecStart=/home/ubuntu/task-manager-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 4

# Dastur to'xtab qolsa 5 soniya ichida qayta yurgizish
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
